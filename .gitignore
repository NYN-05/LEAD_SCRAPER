*.db-wal
*.db-shm
*.db-journal

# Playwright / browser test artifacts
test-results/
playwright-report/
.playwright/

# Logs and tooling caches
*.log
.npm-cache/
structure.txt

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Local scratch files
*.tmp
*.bak
scratch/
tmp/

# Sample exports and the seeded SQLite database are intentionally tracked:
